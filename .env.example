# 光鸭云盘 API 服务运行配置（复制为 .env 后填写）

# ===== 账号凭据 =====
# 一般留空即可：调用 /auth/sms/start + /auth/sms/confirm 登录后，
# access_token / refresh_token / device_id / 过期时间会自动写入 data/tokens.json，
# 服务重启后自动读取，无需手填。
#
# 如果你已从别处拿到 token，也可以直接填在这里（仅首次导入用）。
ACCESS_TOKEN=
# 用于 access_token 过期后自动刷新
REFRESH_TOKEN=
# 留空自动生成并持久化到 data/tokens.json
DEVICE_ID=

# ===== 接口保护（可选） =====
# 填写后所有请求需带请求头 X-API-Key；留空则不校验
API_KEY=

# ===== 令牌持久化 =====
# 登录/刷新后的 token 保存位置
TOKEN_FILE=data/tokens.json

# ===== 服务监听 =====
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=info

# ===== 上传（默认按 1 vCPU / 1 GB 内存 / 24 GB 磁盘调优，文件多为 1GB+） =====
# 分片大小（字节）。默认 8MB：1GB 文件约 128 片，单机内存无压力；
# 调大可减少请求数，但要保证「分片大小 × 并发上传数」不会吃满内存。
UPLOAD_CHUNK_SIZE=8388608
# 上传等长耗时请求的读写超时（秒）。httpx 默认仅 5 秒，大文件上传会被中断，这里放宽到 5 分钟。
UPLOAD_TIMEOUT=300
# 分片上传临时目录（放在数据盘，避免写满 /tmp）。留空则用系统临时目录。
UPLOAD_TMP_DIR=data/tmp
# 上传请求遇到网络类错误（如 OSS 断开连接 RemoteProtocolError）时的重试次数。
UPLOAD_RETRIES=3
# /upload/path 允许访问的根目录；留空=不限制（服务仅内网可访问 + API_KEY 保护）。
UPLOAD_ROOT=
# 同时进行的上传数上限，防止 1GB 内存的小机器被并发占满。
MAX_CONCURRENT_UPLOADS=2
